{
  "name": "mission-sea-turtle-nest",
  "friendlyName": "Mission Sea Turtle Nest",
  "version": "0.9.0",
  "homepage": "https://turtle-quest.vercel.app/",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^25.5.0",
    "eslint": "^8.57.1",
    "prettier": "^3.7.4",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "vite": "^8.0.1"
  },
  "scripts": {
    "dev": "npx vite",
    "start": "npm run dev",
    "build": "tsc -b && vite build",
    "create:prey": "node --experimental-strip-types create.ts prey",
    "create:obstacle": "node --experimental-strip-types create.ts obstacle",
    "lint": "eslint .",
    "format": "prettier . --write"
  }
}
